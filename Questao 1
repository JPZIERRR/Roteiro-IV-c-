using System;


public class Pagamento()
{
    public virtual void ProcessarPagamento()
    {
        Console.WriteLine("Processar pagamento");
    }
}

public class CartaoCredito : Pagamento
{
    public override void ProcessarPagamento()
    {
        Console.WriteLine("Pagamento no crédito.");
    }
}

public class BoletoBancario : Pagamento
{
    public override void ProcessarPagamento()
    {
        Console.WriteLine("Pagamento no boleto bancario.");
    }
}

public class Pix : Pagamento
{
    public override void ProcessarPagamento()
    {
        Console.WriteLine("Pagamento no pix.");
    }
}


public class Program
{
    static void Main()
    {
        List<Pagamento> pagamentos = new List<Pagamento>{
        
            new Pix(),
            new BoletoBancario(),
            new CartaoCredito()
        };

        foreach (Pagamento p in pagamentos)
        {
            p.ProcessarPagamento();
        }

        Console.ReadLine();
    }
}
